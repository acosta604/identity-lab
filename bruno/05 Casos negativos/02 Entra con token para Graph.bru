meta {
  name: Entra con token para Graph
  type: http
  seq: 2
}

post {
  url: {{entraUrl}}/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: graph-alice
  client_secret: lab
  scope: token-exchange-service
}

script:post-response {
  bru.setVar("graphToken", res.body.access_token);
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
}
