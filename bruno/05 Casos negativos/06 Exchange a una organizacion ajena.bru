meta {
  name: Exchange a una organizacion ajena
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/token/exchange
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: urn:ietf:params:oauth:grant-type:token-exchange
  subject_token: {{entraToken}}
  subject_token_type: urn:ietf:params:oauth:token-type:access_token
  tenant: acme
  organization: globex-main
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
}

docs {
  globex-main es de otro tenant. Si el token de Entra ya vencio, repite 01/01 primero.
}
